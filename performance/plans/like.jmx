            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (prev.getResponseCode() != '200') { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('预期HTTP 200，实际'+prev.getResponseCode()); }
def j=new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()); if(j.liked!=true || j.post_id.toString()!=vars.get('target_post')) {AssertionResult.setFailure(true);AssertionResult.setFailureMessage('点赞返回状态不正确');}</stringProp>
          </JSR223Assertion>
